# ─────────────────────────────────────────────────────────────────────────────
# TripPilot environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is optional: with nothing set, TripPilot runs in demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for SEO metadata, sitemap and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database, authentication, storage) ────────────────────────────
# Project Settings → API in the Supabase dashboard.
# The anon key is safe in the browser; Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Anthropic (AI trip planner + concierge) ─────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# ── Maps ────────────────────────────────────────────────────────────────────
# "osm" (default, no key: OpenStreetMap data with CARTO tiles) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=osm
# Required only when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── AI usage limits (per traveler) ──────────────────────────────────────────
# Credits per rolling 24h. Costs: itinerary 5, day re-plan 2, activity swap 1, concierge message 1.
AI_DAILY_CREDIT_LIMIT=60
# Max AI requests per rolling 10 minutes.
AI_BURST_LIMIT=20

# ── Geocoding (placing addresses on the map) ────────────────────────────────
# Uses Mapbox when a token is set (server-side MAPBOX_TOKEN, or NEXT_PUBLIC_MAPBOX_TOKEN),
# otherwise OpenStreetMap Nominatim (free, 1 request/second, no key).
MAPBOX_TOKEN=
# Contact address sent in the Nominatim User-Agent, as its usage policy requests (operator's, not users').
GEOCODER_CONTACT_EMAIL=
