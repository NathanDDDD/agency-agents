# ─────────────────────────────────────────────────────────────────────────────
# TripPilot environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is optional: with nothing set, TripPilot runs in demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for SEO metadata, sitemap and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database, authentication, storage) ────────────────────────────
# Project Settings → API in the Supabase dashboard.
# The anon key is safe in the browser; Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Anthropic (AI trip planner + concierge) ─────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# ── Maps ────────────────────────────────────────────────────────────────────
# "osm" (default, no key: OpenStreetMap data with CARTO tiles) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=osm
# Required only when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN=
